# Hermes Agent 101: copy this file to .env for `vercel dev`, and add the same values in
# Vercel > Project > Settings > Environment Variables. Every value here stays on the server.

# --- Hermes (the AI engine) -----------------------------------------------------------------
# Base URL of the Hermes server, no trailing slash, e.g. https://xxxx.trycloudflare.com
# Leave empty to run with the offline practice agent only.
HERMES_URL=
# One key per Hermes profile. The website calls POST ${HERMES_URL}/p/<profile>/v1/chat/completions
# with "Authorization: Bearer <key>". Ask the Hermes operator for these.
# h101-lab: SOUL.md tester (no tools; acts as the SOUL.md the student wrote)
HERMES_KEY_LAB=
# h101-mentor: dashboard assistant (no tools; staff only)
HERMES_KEY_MENTOR=
# h101-researcher: Atlas, cited answers from web search
HERMES_KEY_RESEARCHER=
# h101-coder: Forge, writes and explains code (can't run it)
HERMES_KEY_CODER=
# h101-assistant: Iris, the Telegram bot, and the daily jobs (also reads GET /h101/automations)
HERMES_KEY_ASSISTANT=
# The Telegram bot that runs Iris, without the @, e.g. Hermes101Bot. Shown to students (not a secret).
TELEGRAM_BOT_USERNAME=

# --- Supabase (accounts, progress, feedback) -------------------------------------------------
SUPABASE_URL=
# Settings > API Keys: the "secret" key (sb_secret_...) or the legacy service_role key. Never the publishable/anon key.
SUPABASE_SERVICE_KEY=

# Optional legacy storage fallback (Vercel KV or Upstash Redis)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Accounts and security --------------------------------------------------------------------
# Super admin: create it in Supabase with `python3 scripts/create-admin.py` (recommended).
# Optional alternative: set both of these to sign in with environment credentials instead.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Workshop Super Admin

# Optional: your site's URL, e.g. https://hermes-agent-101.vercel.app. Other sites then can't use
# your Hermes agents through this site's /api/chat and /api/agents-chat.
ALLOWED_ORIGIN=

# Optional: lets facilitators view passwords. Generate a long random value (openssl rand -base64 32) and keep it secret.
PASSWORD_VIEW_KEY=

# Optional: time zone for the dashboard's "messages today" counts. Default Asia/Manila.
WORKSHOP_TZ=

# Local preview only: skip the login screen. student = open the lab as "Preview Student",
# admin = open the dashboard as "Preview Admin". Ignored on Vercel, so never set it there.
DEV_AUTO_LOGIN=
